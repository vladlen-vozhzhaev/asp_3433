@model WebApplication3.Models.Article

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p class="text-muted">Автор: @Model.Author | Опубликовано: @Model.CratedAt.ToString("dd.MM.yyyy")</p>

<hr>

<div>
    @Model.Content
</div>

<hr>
<div class="mt-3">
    <a asp-action="Articles" class="btn btn-primary btn-sm">Ко всем постам</a><br><br>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">Редактировать</a><br><br>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="@Model.Id">
        <input type="submit" class="btn btn-danger btn sm" value="Удалить">
    </form>
</div>

